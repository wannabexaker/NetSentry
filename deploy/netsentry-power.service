[Unit]
Description=NetSentry — root maintenance helper (reboot, apt upgrade, Docker clean-up)

[Service]
Type=oneshot
# The helper consumes the request first, so it can never fire twice, and acts
# only on a word from its fixed list (reboot, refresh, upgrade, prune,
# kernels-plan, kernels, eeprom, status, health); anything else is ignored.
# Installed from deploy/netsentry-maintenance-helper.sh, root:root 0755.
ExecStart=/usr/local/lib/netsentry/maintenance-helper /home/__USER__/.local/share/netsentry/power/request
# An upgrade can take a while on an SD card.
TimeoutStartSec=70min
